@model IEnumerable<WebApplication1.Models.ProjectItem>

@{
    ViewData["Title"] = "Featured Portfolio Projects";
}

<div class="container my-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Featured Projects</h1>
        <p class="lead text-muted">A showcase of software solutions, hackathon projects, and web applications.</p>
    </div>

    <div class="row g-4">
        @foreach (var project in Model)
        {
            <div class="col-md-6">
                <div class="card h-100 shadow-sm border-0 rounded-3">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary px-3 py-2 rounded-pill">@project.Category</span>
                        </div>
                        <h3 class="card-title fw-bold text-dark mb-1">@project.Title</h3>
                        <h6 class="text-secondary mb-3">@project.Subtitle</h6>
                        <p class="card-text text-muted flex-grow-1">@project.Description</p>

                        <div class="mb-4">
                            <strong class="d-block text-dark mb-2">Tech Stack:</strong>
                            @foreach (var tech in project.TechStack)
                            {
                                <span class="badge bg-light text-dark border me-1 mb-1 px-2 py-1">@tech</span>
                            }
                        </div>

                        <div class="pt-3 border-top">
                            <a href="@project.Url" target="_blank" class="btn btn-outline-dark w-100">
                                View Project
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>