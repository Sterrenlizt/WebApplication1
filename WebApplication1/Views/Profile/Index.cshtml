@model WebApplication1.Models.ProfileModel
@{
    ViewData["Title"] = "Olivia's Edit Portfolio";
}
<div class="profile-bg">
    <header class="bg-section">
        <h2 class="text-center"><b>About Me</b></h2>
        <section class="about-me">
                <div>
                <p><b>Name:</b> @Model.Name</p>
                <p><b>Age:</b> @Model.Age</p>
                <p><b>Education:</b> @Model.Education</p>
                <p><b>Tools:</b> @Model.Tools</p>
                <p><b>Hobbies:</b> @Model.Hobbies</p>
                <p><b>Interests:</b> @Model.Interests</p>
            </div>
            <div class="img">
                <img src="@Model.ImagePath" height="200"/>
            </div>
        </section>
    </header>
    <main>
        <h2 class="text-center bg-section"><b>Video Edits</b></h2>
        <section class="edit">
            <div class="edit-box">
                <iframe src="https://www.youtube.com/embed/MS6d9D2SyfM" allowfullscreen></iframe>
            </div>
            <div class="edit-box">
                <iframe src="https://www.youtube.com/embed/GnMlcQbTIL4" allowfullscreen></iframe>
            </div>
            <div class="edit-box">
                <iframe src="https://www.youtube.com/embed/v478Ezi3-o8" allowfullscreen></iframe>
            </div>
            <div class="edit-box">
                <iframe src="https://www.youtube.com/embed/mMNry_jzj1A" allowfullscreen></iframe>
            </div>
            <div class="edit-box">
                <iframe src="https://www.youtube.com/embed/aOi3afE3BO8" allowfullscreen></iframe>
            </div>
        </section>
        <h2 class="text-center bg-section"><b>Audio Edits</b></h2>
        <section class="edit">

        </section>
    </main>
    <footer class="bg-section">
        <h2 class="text-center"><b>My Social Media</b></h2>
    </footer>
    
</div>